    "@testing-library/react": "16.1.0",
    "@types/jsdom": "21.1.7",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
