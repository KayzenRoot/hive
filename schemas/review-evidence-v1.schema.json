{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kayzenroot.github.io/hive/schemas/review-evidence-v1.schema.json",
  "title": "HIVE Review Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_order",
    "repository",
    "pull_request",
    "base",
    "head",
    "generated_at",
    "changed_files",
    "migrations",
    "checks",
    "benchmark",
    "evidence",
    "governance",
    "artifact",
    "review_state",
    "negative_scope"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "work_order": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "is_draft"],
      "properties": {
        "number": { "type": ["integer", "null"], "minimum": 1 },
        "is_draft": { "type": "boolean" }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "changed_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "paths"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head"],
      "properties": { "head": { "type": "string", "minLength": 1 } }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation", "canonical", "secrets", "lint", "typecheck", "tests", "build", "integration", "review_evidence"],
      "properties": {
        "validation": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "canonical": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "secrets": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "lint": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "typecheck": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "tests": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "build": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "integration": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "review_evidence": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "query_count", "recall_at_1", "recall_at_5", "mrr", "critical_context_misses", "two_run_reproducibility", "cross_project_isolation", "redis_restart", "api_restart"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "query_count": { "type": "integer", "minimum": 0 },
        "recall_at_1": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
        "mrr": { "type": "number", "minimum": 0, "maximum": 1 },
        "critical_context_misses": { "type": "integer", "minimum": 0 },
        "two_run_reproducibility": { "type": "boolean" },
        "cross_project_isolation": { "type": "boolean" },
        "redis_restart": { "type": "boolean" },
        "api_restart": { "type": "boolean" },
        "semantic": { "$ref": "#/$defs/benchmark_slice" },
        "hybrid": { "$ref": "#/$defs/benchmark_slice" },
        "rerank": { "$ref": "#/$defs/rerank_benchmark" },
        "semantic_integrity": { "$ref": "#/$defs/semantic_integrity" },
        "fallback": { "$ref": "#/$defs/fallback" },
        "hybrid_recall_at_5_gte_extended_lexical": { "type": "boolean" },
        "semantic_challenge_recovered": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "integration", "security", "warnings"],
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "backend", "dashboard"],
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
            "backend": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "passed", "failed", "skipped", "errors"],
              "properties": {
                "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "skipped": { "type": "integer", "minimum": 0 },
                "errors": { "type": "integer", "minimum": 0 }
              }
            },
            "dashboard": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "passed", "failed", "skipped"],
              "properties": {
                "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "skipped": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "project_registry", "task_intake_cas", "repository_indexing", "retrieval", "redis_restart", "api_restart", "benchmark_gate", "cross_project_retrieval", "integrity_tests"],
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
            "project_registry": { "$ref": "#/$defs/result" },
            "task_intake_cas": { "$ref": "#/$defs/result" },
            "repository_indexing": { "$ref": "#/$defs/result" },
            "retrieval": { "$ref": "#/$defs/result" },
            "redis_restart": { "$ref": "#/$defs/result" },
            "api_restart": { "$ref": "#/$defs/result" },
            "reranking": { "$ref": "#/$defs/result" },
            "context_manager": { "$ref": "#/$defs/context_manager_evidence" },
            "memory": { "$ref": "#/$defs/memory_lifecycle_evidence" },
            "benchmark_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "query_count", "recall_at_1", "recall_at_5", "mrr", "critical_context_misses", "two_run_reproducibility"],
              "properties": {
                "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
                "query_count": { "type": "integer", "minimum": 0 },
                "recall_at_1": { "type": "number", "minimum": 0, "maximum": 1 },
                "recall_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
                "mrr": { "type": "number", "minimum": 0, "maximum": 1 },
                "critical_context_misses": { "type": "integer", "minimum": 0 },
                "two_run_reproducibility": { "type": "boolean" }
              }
            },
            "cross_project_retrieval": { "$ref": "#/$defs/result" },
            "integrity_tests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["head_race_rejected", "inventory_race_rejected", "prior_corpus_preserved", "duplicate_task_candidate_collapsed", "task_provenance_preserved", "cross_project_duplicate_isolation"],
              "properties": {
                "head_race_rejected": { "type": "boolean" },
                "inventory_race_rejected": { "type": "boolean" },
                "prior_corpus_preserved": { "type": "boolean" },
                "duplicate_task_candidate_collapsed": { "type": "boolean" },
                "task_provenance_preserved": { "type": "boolean" },
                "cross_project_duplicate_isolation": { "type": "boolean" },
                "semantic_challenge_recovered": { "type": "boolean" },
                "hybrid_fallback_provider_error": { "type": "boolean" },
                "hybrid_fallback_stale": { "type": "boolean" },
                "semantic_project_isolation": { "type": "boolean" },
                "rerank_recall_at_5_gte_hybrid": { "type": "boolean" },
                "rerank_mrr_gte_hybrid": { "type": "boolean" },
                "rerank_strict_rank_improvement": { "type": "boolean" },
                "rerank_candidate_pool_bounded": { "type": "boolean" },
                "rerank_provenance_preserved": { "type": "boolean" },
                "rerank_disabled_exact_fallback": { "type": "boolean" },
                "rerank_invalid_response_safe": { "type": "boolean" },
                "rerank_provider_failure_safe": { "type": "boolean" },
                "rerank_provider_down_safe": { "type": "boolean" },
                "rerank_project_isolation": { "type": "boolean" },
                "rerank_duplicate_task_collapsed": { "type": "boolean" },
                "rerank_cross_project_duplicate_isolation": { "type": "boolean" },
                "rerank_missing_index_safe": { "type": "boolean" },
                "rerank_out_of_range_index_safe": { "type": "boolean" },
                "rerank_duplicate_index_safe": { "type": "boolean" },
                "rerank_non_finite_score_safe": { "type": "boolean" },
                "rerank_model_mismatch_safe": { "type": "boolean" },
                "rerank_malformed_response_matrix": { "type": "boolean" },
                "rerank_default_order_preserved": { "type": "boolean" },
                "rerank_fallback_scores_null": { "type": "boolean" },
                "rerank_strict_invalid_response_bounded": { "type": "boolean" },
                "rerank_semantic_stale_state_preserved": { "type": "boolean" },
                "rerank_secret_not_leaked": { "type": "boolean" },
                "rerank_ordering_reproducible": { "type": "boolean" }
              }
            },
            "semantic_hybrid": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "semantic", "hybrid", "semantic_integrity", "fallback"],
              "properties": {
                "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
                "semantic": { "$ref": "#/$defs/benchmark_slice" },
                "hybrid": { "$ref": "#/$defs/benchmark_slice" },
                "semantic_integrity": { "$ref": "#/$defs/semantic_integrity" },
                "fallback": { "$ref": "#/$defs/fallback" },
                "rerank": { "$ref": "#/$defs/rerank_benchmark" }
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "canonical_verifier", "secret_scan", "project_isolation", "cross_project_retrieval", "sql_query_parameterization", "source_staleness_fail_closed"],
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
            "canonical_verifier": { "$ref": "#/$defs/result" },
            "secret_scan": { "$ref": "#/$defs/result" },
            "project_isolation": { "$ref": "#/$defs/result" },
            "cross_project_retrieval": { "$ref": "#/$defs/result" },
            "sql_query_parameterization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "basis"],
              "properties": {
                "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
                "basis": { "type": "string", "minLength": 1 }
              }
            },
            "source_staleness_fail_closed": { "$ref": "#/$defs/result" },
            "reranking": { "$ref": "#/$defs/result" }
          }
        },
        "warnings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count", "items"],
          "properties": {
            "status": { "type": "string", "enum": ["NONE", "RECORDED"] },
            "count": { "type": "integer", "minimum": 0 },
            "items": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ruleset", "repository_merge_settings"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "UNKNOWN"] },
        "ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "enforcement", "required_contexts", "required_review_thread_resolution", "allowed_merge_methods", "bypass_actors", "deletion_protection", "non_fast_forward_protection", "pull_request_required", "strict_required_status_checks"],
          "properties": {
            "id": { "type": ["integer", "null"], "minimum": 1 },
            "name": { "type": "string", "minLength": 1 },
            "enforcement": { "type": "string", "minLength": 1 },
            "required_contexts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "required_review_thread_resolution": { "type": ["boolean", "null"] },
            "allowed_merge_methods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "bypass_actors": { "type": "array", "items": { "$ref": "#/$defs/bypass_actor" } },
            "deletion_protection": { "type": "boolean" },
            "non_fast_forward_protection": { "type": "boolean" },
            "pull_request_required": { "type": "boolean" },
            "strict_required_status_checks": { "type": ["boolean", "null"] }
            ,"required_approving_review_count": { "type": ["integer", "null"], "minimum": 0 }
            ,"dismiss_stale_reviews_on_push": { "type": ["boolean", "null"] }
            ,"require_last_push_approval": { "type": ["boolean", "null"] }
            ,"require_extra_approval_for_unattributed_changes": { "type": ["boolean", "null"] }
          }
        },
        "repository_merge_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow_squash_merge", "allow_merge_commit", "allow_rebase_merge", "delete_branch_on_merge", "allow_auto_merge"],
          "properties": {
            "allow_squash_merge": { "type": ["boolean", "null"] },
            "allow_merge_commit": { "type": ["boolean", "null"] },
            "allow_rebase_merge": { "type": ["boolean", "null"] },
            "delete_branch_on_merge": { "type": ["boolean", "null"] },
            "allow_auto_merge": { "type": ["boolean", "null"] }
          }
        },
        "ruleset_unchanged": { "type": "boolean" },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "number": { "type": ["integer", "null"], "minimum": 1 },
            "state": { "type": ["string", "null"] },
            "is_draft": { "type": ["boolean", "null"] },
            "head_sha": { "type": ["string", "null"] },
            "base_sha": { "type": ["string", "null"] },
            "auto_merge_armed": { "type": "boolean" },
            "auto_merge_method": { "type": ["string", "null"] },
            "auto_merge": { "$ref": "#/$defs/auto_merge" }
          }
        },
        "approval_gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_approving_review_count": { "type": ["integer", "null"], "minimum": 0 },
            "dismiss_stale_reviews_on_push": { "type": ["boolean", "null"] },
            "require_last_push_approval": { "type": ["boolean", "null"] },
            "require_extra_approval_for_unattributed_changes": { "type": ["boolean", "null"] },
            "independent_approvers": { "type": "array", "items": { "type": "string" } },
            "independent_approval_count": { "type": "integer", "minimum": 0 }
          }
        },
        "sol_reviewer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "login": { "type": "string" },
            "permission": { "type": ["string", "null"] },
            "permissions": { "type": "object" },
            "can_satisfy_required_approval": { "type": "boolean" }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format", "bounded"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "format": { "const": "consolidated-directory" },
        "bounded": { "const": true }
      }
    },
    "review_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "merge_performed"],
      "properties": {
        "status": { "type": "string", "enum": ["DRAFT", "READY", "OPEN", "MERGED", "NOT_CREATED"] },
        "merge_performed": { "const": false },
        "sol_review_state": { "type": "string", "enum": ["AWAITING_SOL", "APPROVED", "REJECTED"] },
        "auto_merge_armed": { "type": "boolean" },
        "auto_merge_method": { "type": ["string", "null"] },
        "auto_merge_owner_login": { "type": "string" },
        "auto_merge_owner_type": { "type": "string" },
        "auto_merge_user_owned": { "type": "boolean" }
      }
    },
    "negative_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "evidence_file": { "type": "string", "minLength": 1 }
      }
    },
    "memory_lifecycle_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_file"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "evidence_file": { "type": "string", "const": "memory-lifecycle.json" },
        "memory_lifecycle_implemented": { "type": "boolean" },
        "memory_postgres_durable": { "type": "boolean" },
        "memory_redis_noncanonical": { "type": "boolean" },
        "memory_project_scoped": { "type": "boolean" },
        "memory_cross_project_rejected": { "type": "boolean" },
        "memory_provenance_queryable": { "type": "boolean" },
        "memory_model_output_staged": { "type": "boolean" },
        "memory_canonical_promotion_qualified": { "type": "boolean" },
        "memory_invalid_promotion_rejected": { "type": "boolean" },
        "memory_history_preserved": { "type": "boolean" },
        "memory_restart_recovery": { "type": "boolean" },
        "memory_redis_loss_recovery": { "type": "boolean" },
        "memory_secrets_not_exposed": { "type": "boolean" },
        "memory_migration_consistent": { "type": "boolean" },
        "memory_migration_changed": { "type": "boolean" },
        "memory_project_count": { "type": "integer", "minimum": 0 },
        "memory_cross_project_rejections": { "type": "integer", "minimum": 0 },
        "memory_provenance_records": { "type": "integer", "minimum": 0 },
        "memory_invalid_promotion_rejections": { "type": "integer", "minimum": 0 },
        "memory_history_versions": { "type": "integer", "minimum": 0 },
        "memory_restart_records": { "type": "integer", "minimum": 0 },
        "memory_redis_loss_records": { "type": "integer", "minimum": 0 },
        "memory_secret_leaks": { "type": "integer", "minimum": 0 },
        "memory_llm_calls": { "type": "integer", "minimum": 0, "maximum": 0 },
        "memory_provider_calls": { "type": "integer", "minimum": 0, "maximum": 0 },
        "memory_evidence_version": { "type": "string", "minLength": 1 },
        "memory_migration_head": { "type": "string", "minLength": 1 }
      }
    },
    "context_manager_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_file",
        "checkpoint_first",
        "governance_project_scoped",
        "task_project_scoped",
        "reranked_retrieval_used",
        "provenance_preserved",
        "deterministic_two_run",
        "bounded",
        "cross_project_isolation",
        "missing_governance_fail_closed",
        "head_race_fail_closed",
        "redis_restart_rebuild",
        "api_restart_rebuild",
        "mandatory_governance_coverage",
        "mandatory_governance_kind_sequence",
        "llm_calls"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "evidence_file": { "type": "string", "minLength": 1 },
        "checkpoint_first": { "type": "boolean" },
        "governance_project_scoped": { "type": "boolean" },
        "task_project_scoped": { "type": "boolean" },
        "reranked_retrieval_used": { "type": "boolean" },
        "provenance_preserved": { "type": "boolean" },
        "deterministic_two_run": { "type": "boolean" },
        "bounded": { "type": "boolean" },
        "cross_project_isolation": { "type": "boolean" },
        "missing_governance_fail_closed": { "type": "boolean" },
        "head_race_fail_closed": { "type": "boolean" },
        "redis_restart_rebuild": { "type": "boolean" },
        "api_restart_rebuild": { "type": "boolean" },
        "mandatory_governance_coverage": { "type": "boolean" },
        "mandatory_governance_kind_sequence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "llm_calls": { "type": ["integer", "null"], "minimum": 0 },
        "progressive_disclosure_level_mapping": { "type": "boolean" },
        "smallest_sufficient": { "type": "boolean" },
        "no_unnecessary_escalation": { "type": "boolean" },
        "explicit_insufficiency_escalation": { "type": "boolean" },
        "bounded_escalation": { "type": "boolean" },
        "stop_on_sufficient": { "type": "boolean" },
        "cross_project_disclosure_fail_closed": { "type": "boolean" },
        "disclosure_llm_calls": { "type": ["integer", "null"], "minimum": 0, "maximum": 0 },
        "adaptive_token_budget_implemented": { "type": ["boolean", "null"] },
        "token_budget_policy_versioned": { "type": "boolean" },
        "token_estimator_versioned": { "type": "boolean" },
        "token_estimator_provider_independent": { "type": "boolean" },
        "token_budget_estimate_serialization_versioned": { "type": "boolean" },
        "final_context_token_estimate_verified": { "type": "boolean" },
        "final_context_estimate_within_effective_budget": { "type": "boolean" },
        "planner_subset_full_payload_regression": { "type": "boolean" },
        "token_budget_uses_approved_deterministic_signals": { "type": "boolean" },
        "token_budget_user_mode_required": { "type": "boolean" },
        "mandatory_governance_preserved_under_budget": { "type": "boolean" },
        "task_constraints_preserved_under_budget": { "type": "boolean" },
        "acceptance_criteria_preserved_under_budget": { "type": "boolean" },
        "progressive_disclosure_semantics_preserved_under_budget": { "type": "boolean" },
        "l4_complete_file_preserved_under_budget": { "type": "boolean" },
        "optional_tail_trim_deterministic": { "type": "boolean" },
        "retained_rerank_order_preserved": { "type": "boolean" },
        "required_context_over_budget_fail_closed": { "type": "boolean" },
        "effective_budget_within_hard_bounds": { "type": "boolean" },
        "token_budget_deterministic_two_run": { "type": "boolean" },
        "token_budget_redis_restart_rebuild": { "type": "boolean" },
        "token_budget_api_restart_rebuild": { "type": "boolean" },
        "adaptive_token_budget_migration_changed": { "type": "boolean" },
        "token_budget_llm_calls": { "type": ["integer", "null"], "minimum": 0, "maximum": 0 },
