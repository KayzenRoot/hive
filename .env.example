# HIVE local configuration. Copy to .env and edit as needed.
HIVE_DATA_ROOT=.hive-data
HIVE_PROJECTS_ROOT=.hive-projects
HIVE_API_PORT=8000
HIVE_DASHBOARD_PORT=3000
POSTGRES_DB=hive
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
HIVE_ENVIRONMENT=development
HIVE_TASK_MAX_UPLOAD_BYTES=10485760
HIVE_TASK_MAX_PDF_PAGES=100
HIVE_TASK_MAX_EXTRACTED_TEXT_BYTES=2097152
HIVE_TASK_MAX_STRUCTURED_TEXT_BYTES=1048576
HIVE_CAS_ZSTD_LEVEL=3

# Semantic retrieval is local-first and disabled by default. Configure a
# trusted OpenAI-compatible embeddings endpoint only when explicitly enabled.
HIVE_EMBEDDING_ENABLED=false
# HIVE_EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# HIVE_EMBEDDING_MODEL=operator-selected-model
# HIVE_EMBEDDING_MODEL_REVISION=
# HIVE_EMBEDDING_DIMENSIONS=384
# HIVE_EMBEDDING_API_KEY=
HIVE_EMBEDDING_TIMEOUT_SECONDS=10
HIVE_EMBEDDING_BATCH_SIZE=16
HIVE_EMBEDDING_MAX_INPUT_CHARS=6000
HIVE_EMBEDDING_MAX_DIMENSIONS=2000
HIVE_EMBEDDING_CANDIDATE_POOL=20
HIVE_EMBEDDING_RRF_K=60
HIVE_EMBEDDING_LEXICAL_WEIGHT=1.0
HIVE_EMBEDDING_SEMANTIC_WEIGHT=1.0

# Reranking is provider-independent, local-first and disabled by default.
# Configure only a trusted HTTP endpoint when explicitly enabling it.
HIVE_RERANK_ENABLED=false
# HIVE_RERANK_BASE_URL=http://127.0.0.1:8080/v1
# HIVE_RERANK_MODEL=operator-selected-model
# HIVE_RERANK_MODEL_REVISION=
# HIVE_RERANK_API_KEY=
HIVE_RERANK_TIMEOUT_SECONDS=10
HIVE_RERANK_CANDIDATE_POOL=20
HIVE_RERANK_MAX_DOCUMENT_CHARS=6000
HIVE_RERANK_MAX_QUERY_CHARS=512
HIVE_RERANK_MAX_RESPONSE_BYTES=2000000

# Examples for HIVE_PROJECTS_ROOT (choose one; keep the mount narrow):
# Windows: D:\Projects
# Linux: /home/user/projects
